<graph id="Stage1B_Interferogram_Deburst">
  <version>1.0</version>
  <!-- Node 1: Read Coregistered Stack -->
  <node id="Read-Stack">
    <operator>Read</operator>
    <sources/>
    <parameters>
      <file>${sourceFile}</file>
    </parameters>
  </node>

  <!-- Node 2: Interferogram Formation & Topographic Phase Subtraction -->
  <node id="Interferogram">
    <operator>Interferogram</operator>
    <sources>
      <sourceProduct refid="Read-Stack"/>
    </sources>
    <parameters>
      <subtractFlatEarthPhase>true</subtractFlatEarthPhase>
      <srpPolynomialDegree>5</srpPolynomialDegree>
      <srpNumberPoints>501</srpNumberPoints>
      <orbitDegree>3</orbitDegree>
      <includeCoherence>true</includeCoherence>
      <cohWinAz>3</cohWinAz>
      <cohWinRg>10</cohWinRg>
      <squarePixel>true</squarePixel>
      <subtractTopographicPhase>true</subtractTopographicPhase>
      <demName>${demName}</demName>
      <outputFlatEarthPhase>false</outputFlatEarthPhase>
      <outputTopoPhase>false</outputTopoPhase>
      <outputElevation>false</outputElevation>
      <outputLatLon>false</outputLatLon>
    </parameters>
  </node>

  <!-- Node 3: TOPSAR-Deburst (reconstruct continuous swath) -->
  <node id="TOPSAR-Deburst">
    <operator>TOPSAR-Deburst</operator>
    <sources>
      <sourceProduct refid="Interferogram"/>
    </sources>
    <parameters>
      <selectedPolarisations>${polarisation}</selectedPolarisations>
    </parameters>
  </node>

  <!-- Node 4: Write Debursted Interferogram -->
  <node id="Write">
    <operator>Write</operator>
    <sources>
      <sourceProduct refid="TOPSAR-Deburst"/>
    </sources>
    <parameters>
      <file>${outputFile}</file>
      <formatName>BEAM-DIMAP</formatName>
    </parameters>
  </node>
</graph>
